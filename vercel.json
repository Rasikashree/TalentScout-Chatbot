{
  "buildCommand": "pip install -r requirements.txt",
  "framework": "python",
  "python": {
    "version": "3.11"
  },
  "env": {
    "STREAMLIT_SERVER_PORT": "3000",
    "STREAMLIT_SERVER_ADDRESS": "0.0.0.0",
    "STREAMLIT_SERVER_HEADLESS": "true"
  },
  "regions": ["iad1"],
  "public": true,
  "ignoreCommand": "git check-ignore -q $VERCEL_FILE_CHANGED_SCOPE || exit 0"
}
